{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rivus",
  "version": "0.1.0",
  "identifier": "dev.rivus.browser",
  "build": {
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rivus",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
